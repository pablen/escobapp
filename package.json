{
  "name": "escobapp",
  "version": "1.9.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/combinations": "1.0.2",
    "@types/node": "26.6.2",
    "array-shuffle": "4.1.0",
    "combinations": "1.0.0",
    "firestore-parser": "0.9.0",
    "framer-motion": "13.4.1",
    "query-string": "9.5.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "workbox-window": "7.4.1"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 3000 --strictPort",
    "start:e2e": "vite --host 127.0.0.1 --port 3001 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "cypress": "cypress open",
    "cypress:headless": "cypress run",
    "cypress:e2e": "cypress run --config baseUrl=http://127.0.0.1:3001",
    "test:e2e": "start-server-and-test \"pnpm run start:e2e\" http://127.0.0.1:3001 \"pnpm run cypress:e2e\"",
    "verify:pwa": "node scripts/verify-pwa-build.mjs",
    "prepare": "husky"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "8.70.1",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "cypress": "16.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-cypress": "6.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jsdom": "30.1.1",
    "lint-staged": "17.5.1",
    "prettier": "3.9.8",
    "start-server-and-test": "3.0.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "cypress"
    ]
  }
}
